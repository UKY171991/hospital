<IfModule mod_rewrite.c>
    RewriteEngine On

    # If mod_rewrite is disabled on the server, this file will be ignored.
    # Keep a root index.php fallback (added in repo root) for shared-hosting compatibility.

    # If someone visits /public directly, redirect to the clean URL.
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Send all non-existing files/directories to Laravel's public folder.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
